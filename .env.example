# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Accounts and per-user data in MongoDB (multi-tenancy). Off by default: the
# app then needs no sign-up and keeps to-dos and notes in the browser's
# localStorage, and MONGODB_URI / JWT_SECRET below are not used.
# Read at BUILD time (NEXT_PUBLIC_), so rebuild or redeploy after changing it.
NEXT_PUBLIC_MULTI_TENANCY=false

# MongoDB connection string (local or Atlas).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-organizer?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/personal-organizer

# LOCAL ONLY, optional. Uncomment if connecting to Atlas fails with
# "querySrv ECONNREFUSED" (DNS SRV lookup issue on some Windows networks).
# Do NOT set this on Vercel.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Secret used to sign session JWTs. Use a long random string (32+ chars), e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
