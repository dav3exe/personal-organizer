# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# MongoDB connection string (local or Atlas).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-organizer?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/personal-organizer

# Secret used to sign session JWTs. Use a long random string (32+ chars), e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
